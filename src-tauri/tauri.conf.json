{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yomi Reader",
  "version": "2.0.1",
  "identifier": "com.yomilab.kiji",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yomi Reader",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "backgroundThrottling": "disabled",
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "mica",
            "acrylic",
            "sidebar"
          ],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "settings",
        "create": false,
        "title": "Yomi Reader Settings",
        "url": "index.html?window=settings",
        "width": 700,
        "height": 660,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "mica",
            "acrylic",
            "sidebar"
          ],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "manage-feeds",
        "create": false,
        "title": "Yomi Reader Feeds",
        "url": "index.html?window=manage-feeds",
        "width": 880,
        "height": 640,
        "minWidth": 660,
        "minHeight": 460,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "mica",
            "acrylic",
            "sidebar"
          ],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "article",
        "create": false,
        "title": "Yomi Reader Article",
        "url": "index.html?window=article",
        "width": 1000,
        "height": 720,
        "visible": false,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "acrylic",
            "underWindowBackground"
          ],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "update",
        "create": false,
        "title": "Yomi Reader Update",
        "url": "index.html?window=update",
        "width": 460,
        "height": 440,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "mica",
            "acrylic",
            "sidebar"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Reader",
      "infoPlist": "./macos-display.plist",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "resources": {
      "icons/": "icons",
      "icons-dark/": "icons-dark",
      "icons-ripple/": "icons-ripple",
      "icons-ripple-dark/": "icons-ripple-dark",
      "icons-circle/": "icons-circle",
      "icons-circle-dark/": "icons-circle-dark"
    },
    "icon": [
      "icons-ripple/32x32.png",
      "icons-ripple/128x128.png",
      "icons-ripple/128x128@2x.png",
      "icons-ripple/icon.icns",
      "icons-ripple/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "DB5CC356-37B3-51DC-AA1E-D7EA8134702E"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "conflicts": [
          "ki-ji"
        ],
        "replaces": [
          "ki-ji"
        ]
      },
      "rpm": {
        "conflicts": [
          "ki-ji"
        ],
        "obsoletes": [
          "ki-ji"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDM0VCRTQ1MjFFMDE0QkYKUldTL0ZPQWhSYjQrVExRejhTZ0pkYzFtbkFtdXV2NmlxNS9MTDk2UERONk5WakMvU3RXRFY5dEEK",
      "endpoints": [
        "https://github.com/yomilab/yomi-rss-reader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
